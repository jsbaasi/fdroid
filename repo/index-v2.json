        "authorName": "jsbaasi",
        "name": {
          "en-US": "Stormreader"
        },
        "summary": {
          "en-US": "EPUB reader that syncs progress and notes over WebDAV"
        },
        "description": {
          "en-US": "A quiet, fast EPUB reader.\n\n* Tap the edges to turn pages, the middle for the menu.\n* Drag the left edge for brightness, down past the screen's minimum.\n* Notes at any position.\n* Progress and notes sync through a WebDAV folder you own, one plain JSON file per book. Each device keeps its own position, and the app offers to jump to whichever device is furthest ahead."
        },
